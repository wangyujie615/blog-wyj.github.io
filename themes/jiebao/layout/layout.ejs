<!DOCTYPE html>
<html lang="<%= config.language || 'zh-CN' %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="<%= config.description || config.title %>">
  <meta name="theme-color" content="#0b0f14">
  <title><%= page.title ? page.title + ' · ' : '' %><%= config.title %></title>
  <script>
    (() => {
      try {
        const saved = localStorage.getItem('jiebao-theme');
        const preferred = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = saved || preferred;
      } catch (_) {}
    })();
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@400;500;600;700&family=Noto+Sans+SC:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="<%- url_for('/css/style.css') %>">
  <%- open_graph({twitter_card: 'summary_large_image'}) %>
</head>
<body class="<%= is_post() ? 'post-page' : 'site-page' %>">
  <header class="site-header" id="site-header">
    <a class="brand" href="<%- url_for('/') %>" aria-label="返回首页">
      <span class="brand-mark">J</span>
      <span><%= config.title %></span>
    </a>
    <div class="header-actions">
      <nav class="nav" aria-label="主导航">
        <% Object.keys(theme.menu || {}).forEach(function(name) { %>
          <a href="<%- url_for(theme.menu[name]) %>"><%= name %></a>
        <% }) %>
      </nav>
      <a class="github-link" href="<%= theme.profile.github %>" target="_blank" rel="noopener noreferrer" aria-label="访问我的 GitHub">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .7a11.5 11.5 0 0 0-3.64 22.41c.58.11.79-.25.79-.56v-2.23c-3.22.7-3.9-1.36-3.9-1.36-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.71.08-.71 1.16.08 1.77 1.19 1.77 1.19 1.04 1.77 2.72 1.26 3.38.96.1-.75.4-1.26.74-1.55-2.57-.29-5.27-1.28-5.27-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.47.11-3.05 0 0 .97-.31 3.16 1.18A11 11 0 0 1 12 6.11c.98 0 1.95.13 2.87.39 2.2-1.49 3.16-1.18 3.16-1.18.63 1.58.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.71 5.39-5.29 5.68.42.36.79 1.07.79 2.16v3.25c0 .31.21.68.8.56A11.5 11.5 0 0 0 12 .7Z"/></svg>
        <span>GitHub</span><i>↗</i>
      </a>
      <button class="theme-toggle" type="button" aria-label="切换为深色模式" title="切换白天/黑夜模式">
        <span class="theme-sun" aria-hidden="true">☀</span>
        <span class="theme-moon" aria-hidden="true">☾</span>
      </button>
      <button class="nav-toggle" type="button" aria-label="打开菜单" aria-expanded="false">
        <span></span><span></span>
      </button>
    </div>
  </header>

  <main><%- body %></main>

  <footer class="site-footer">
    <p><%= theme.footer_text %></p>
    <p>© <%= new Date().getFullYear() %> <%= config.author || config.title %></p>
  </footer>
  <script src="<%- url_for('/js/vendor/mermaid.min.js') %>"></script>
  <script src="<%- url_for('/js/main.js') %>"></script>
</body>
</html>
