<section class="archive-page">
  <header class="archive-header">
    <p class="kicker">ALL STORIES</p>
    <h1><%= page.archive ? '文章归档' : page.title %></h1>
    <p>共 <%= site.posts.length %> 篇记录，按时间倒序排列。</p>
  </header>
  <div class="archive-list">
    <% page.posts.each(function(post) { %>
      <a class="archive-item reveal" href="<%- url_for(post.path) %>">
        <time><%= date(post.date, 'YYYY.MM.DD') %></time>
        <h2><%= post.title %></h2>
        <span>→</span>
      </a>
    <% }) %>
  </div>
  <% if (page.total > 1) { %><nav class="pagination"><%- paginator({prev_text: '← 上一页', next_text: '下一页 →'}) %></nav><% } %>
</section>

