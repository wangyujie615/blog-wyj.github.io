<% const articleToc = toc(page.content, {list_number: false, min_depth: 2, max_depth: 4}); %>
<div class="article-shell">
  <article class="article-page">
    <header class="article-hero">
      <a class="back-link" href="<%- url_for('/#articles') %>">← 返回文章列表</a>
      <p class="post-meta"><time datetime="<%= date_xml(page.date) %>"><%= date(page.date, 'YYYY.MM.DD') %></time><span>·</span><%= page.tags && page.tags.length ? page.tags.first().name : '随笔' %></p>
      <h1><%= page.title %></h1>
      <% if (page.description) { %><p class="article-description"><%= page.description %></p><% } %>
      <% if (page.tags && page.tags.length) { %>
        <div class="article-tags">
          <% page.tags.toArray().forEach(function(tag) { %><a href="<%- url_for(tag.path) %>"># <%= tag.name %></a><% }) %>
        </div>
      <% } %>
    </header>
    <div class="article-content"><%- page.content %></div>
    <footer class="article-end">
      <span>END</span>
      <a href="<%- url_for('/#articles') %>">继续阅读其他文章 →</a>
    </footer>
  </article>
  <% if (articleToc) { %>
    <aside class="toc-sidebar">
      <div class="toc-panel">
        <p class="toc-title"><span></span>本篇目录</p>
        <%- articleToc %>
      </div>
    </aside>
  <% } %>
</div>
